#version 330 core
// First-person held tool (vertex-colored mesh). Drawn in view space, like
// the arm, so there is no view matrix.
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;
layout (location = 2) in vec3 aColor;

out vec3 vNormal;
out vec3 vColor;

uniform mat4 projection;
uniform mat4 model;

void main() {
    vNormal = normalize(mat3(model) * aNormal); // rotation + uniform scale only
    vColor = aColor;
    gl_Position = projection * model * vec4(aPos, 1.0);
}
