#version 330 core
in vec2 TexCoord;
in float texLayer;
in float brightness;
in vec3 vertexColor;

out vec4 FragColor;

uniform sampler2DArray ourTexture;
uniform vec3 tintColor;
uniform float glowMode; // 0 = textured (default), 1 = radial gradient for bloom halo, 2 = flat per-vertex colour (cube particles), 3 = torch tip rings
uniform vec3 tintColorLow; // glowMode 3: the tip's lower ring (tintColor = upper ring)
uniform vec3 tintColorFace; // glowMode 3: the tip's top face

void main() {
    if (glowMode > 2.5) {
        // Torch tip (torch_model.cpp): flat, two rings split at v = 9/16;
        // the top face (brightness TIP_TOP_FACE_BOOST) has its own colour.
        vec3 c = brightness > 1.1 ? tintColorFace : (TexCoord.y > 0.5625 ? tintColor : tintColorLow);
        FragColor = vec4(min(c, vec3(1.0)), 1.0);
    } else if (glowMode > 1.5) {
        FragColor = vec4(vertexColor * tintColor * brightness, 1.0);
    } else if (glowMode > 0.5) {
        // Radial falloff from quad center — soft bloom halo
        float d = distance(TexCoord, vec2(0.5));
        float alpha = clamp(1.0 - d * 2.0, 0.0, 1.0);
        alpha = alpha * alpha; // quadratic falloff for softer edge
        FragColor = vec4(tintColor * brightness, alpha);
    } else {
        // `brightness` doubles as an alpha multiplier so particle systems
        // (smoke plume) can fade out without needing a dedicated uniform.
        // Sun/moon/arm/held-block all pass brightness=1.0 so they're
        // unaffected.
        vec4 texColor = texture(ourTexture, vec3(TexCoord, texLayer));
        FragColor = vec4(texColor.rgb * brightness * tintColor, texColor.a * brightness);
    }
}
