#version 330 core
in vec3 vNormal;
in vec3 vColor;
in vec3 vPos;

out vec4 FragColor;

uniform vec3 lightTint; // sun/moon/sky/block light where the item is
uniform vec3 keyDir;    // key light direction, same space as vPos
// Distance fog, same ramp as the chunk shader; first person passes a far
// fogStart/fogEnd so it never fogs.
uniform vec3 cameraPos;
uniform vec3 fogColor;
uniform float fogStart;
uniform float fogEnd;

void main() {
    float shade = 0.55 + 0.45 * max(dot(normalize(vNormal), normalize(keyDir)), 0.0);
    vec3 lit = vColor * shade * lightTint;
    float dist = length(vPos.xz - cameraPos.xz);
    float fog = clamp((fogEnd - dist) / (fogEnd - fogStart), 0.0, 1.0);
    FragColor = vec4(mix(fogColor, lit, fog), 1.0);
}
